                            <Rectangle width="10" height="18" originX="0" originY="0" cornerRadiusBL="3" cornerRadiusBR="3" name="R"/>
                            <Fill name="F"><SolidColor colorValue="FFFFD166" name="C"/></Fill>
                        </Shape>
                        <Shape x="64" y="12" name="Tooth2">
                            <Rectangle width="10" height="12" originX="0" originY="0" cornerRadiusBL="3" cornerRadiusBR="3" name="R"/>
                            <Fill name="F"><SolidColor colorValue="FFFFD166" name="C"/></Fill>
                        </Shape>
                    </Node>
                    <Shape x="86" y="-4" name="KeyRing">
                        <Ellipse width="40" height="40" name="Ring"/>
                        <Stroke thickness="11" name="Glow"><SolidColor colorValue="88FFD166" name="C"/><Feather strength="8" name="Fe"/></Stroke>
                        <Stroke thickness="10" name="S"><SolidColor colorValue="FFFFD166" name="C"/></Stroke>
                    </Shape>
                    <Shape name="Sleeve">
                        <PointsPath isClosed="true" name="P">
                            <StraightVertex x="-10" y="-22" radius="20"/>
                            <StraightVertex x="78" y="-14" radius="14"/>
                            <StraightVertex x="78" y="12" radius="14"/>
                            <StraightVertex x="-10" y="26" radius="20"/>
                        </PointsPath>
                        <Fill name="F"><SolidColor colorValue="FF3A2160" name="C"/></Fill>
                    </Shape>
                </Node>

                <!-- face, in the hood -->
                <Node y="-250" name="Face" id="0:40">
                    <Shape y="46" name="Mouth" id="0:41">
                        <Ellipse width="40" height="12" name="MouthPath" id="0:43">
