<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" styleId="0:5" viewModelId="0:100" viewModelInstanceId="0:110" width="600" height="700" name="Thief" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Fill name="Sky">
