                </Node>

                <!-- rim light on the left edge -->
                <Shape name="Rim">
                    <PointsPath isClosed="false" name="P">
                        <StraightVertex x="-104" y="-30"/>
                        <CubicDetachedVertex x="-112" y="-190" inRotation="1.5708" inDistance="60" outRotation="-1.5708" outDistance="60"/>
                        <CubicDetachedVertex x="-30" y="-318" inRotation="2.6" inDistance="50" outRotation="-0.5" outDistance="20"/>
                    </PointsPath>
                    <Stroke thickness="9" cap="round" name="S"><SolidColor colorValue="FF8A5BC8" name="C"/></Stroke>
                </Shape>

                <!-- body: a hooded drop -->
                <Shape name="Body" id="0:50">
                    <PointsPath isClosed="true" isClockwise="true" name="P">
                        <CubicMirroredVertex x="0" y="-335" rotation="0" distance="80"/>
