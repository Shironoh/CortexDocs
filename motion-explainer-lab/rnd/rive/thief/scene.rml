                <Node x="70" y="-190" name="Arm" id="0:30">
                    <DataBindContext sourcePathIds="0:100-0:104" propertyKey="15" converterId="0:122"/>
                    <Node x="86" y="-4" rotation="-0.6" name="KeyBlade">
                        <Shape x="22" name="Shaft">
