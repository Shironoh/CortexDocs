                            <Fill name="Core"><SolidColor colorValue="FFFF5C7F" name="C"/></Fill>
                            <Stroke thickness="7" name="Glow"><SolidColor colorValue="99FF3B6B" name="C"/><Feather strength="9" name="Fe"/></Stroke>
