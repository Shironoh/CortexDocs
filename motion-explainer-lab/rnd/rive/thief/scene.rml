        <!-- rig root: lean is bound; first declared paints on top -->
        <Node x="300" y="640" name="Rig" id="0:20">
            <DataBindContext sourcePathIds="0:100-0:103" propertyKey="15" converterId="0:121"/>

            <Node name="Breath" id="0:25">
