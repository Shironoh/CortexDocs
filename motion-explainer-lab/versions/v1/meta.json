 "cues": [
  {
   "id": "c1",
   "start": 0.6,
   "end": 7.369230769230769,
   "say": "Trois heures douze. Alerte : un compte Gmail inconnu est devenu propriétaire du projet prod paiements.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c2",
   "start": 7.369230769230769,
   "end": 14.523076923076921,
   "say": "Vous ne connaissez pas Google Cloud. Seule piste : ses journaux d'audit. Qui ? Quand ? D'où ? Et ensuite ?",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c3",
   "start": 14.523076923076921,
   "end": 22.06153846153846,
   "say": "Google Cloud, c'est un immeuble : l'organisation est le bâtiment, chaque projet un étage, avec machines et données.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c4",
   "start": 22.06153846153846,
   "end": 29.6,
   "say": "Personne n'entre par la fenêtre : console, ligne de commande ou script, tout passe par le guichet : l'API.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c5",
   "start": 29.6,
   "end": 38.292307692307695,
   "say": "Sans rien configurer, a-t-on une trace ? Oui : tout appel qui modifie un réglage est écrit dans le registre Admin Activity.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c6",
   "start": 38.292307692307695,
   "end": 47.753846153846155,
   "say": "On croit qu'il fallait l'activer. Faux : toujours écrit, impossible à couper, gardé quatre cents jours. Les modifications sont rares : ça coûte peu.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c7",
   "start": 47.753846153846155,
   "end": 57.56153846153846,
   "say": "Devinez : devenu propriétaire, l'attaquant peut-il effacer ce registre ? | Non : son coffre, Required, ne se supprime pas. L'historique est intact.",
   "guess": true,
   "pauseAt": 50.830769230769235
  },
  {
   "id": "c9",
   "start": 57.56153846153846,
   "end": 67.40769230769232,
   "say": "Ouvrons l'entrée de trois heures sept. Quoi ? Set I A M Policy, un changement de droits : le rôle Owner, donné au compte Gmail.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c10",
   "start": 67.40769230769232,
   "end": 77.60000000000001,
   "say": "Et qui a signé ? | Pas un humain : ci déployeur, un compte de service, l'identité d'un robot. Sa clé a fuité.",
   "guess": true,
   "pauseAt": 68.94615384615385
  },
  {
   "id": "c11",
   "start": 77.60000000000001,
   "end": 85.13846153846154,
   "say": "D'où ? Une IP externe, et un nom d'outil déclaré par l'appelant lui-même : un indice, pas une preuve.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c12",
   "start": 85.13846153846154,
   "end": 91.13846153846154,
   "say": "Côté sim, une règle tient en quatre champs : méthode, signataire, adresse, rôle ajouté.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c13",
   "start": 91.13846153846154,
   "end": 97.13846153846154,
   "say": "A-t-il lu les fichiers clients ? Admin Activity note les modifications, pas les lectures.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c14",
   "start": 97.13846153846154,
   "end": 106.94615384615385,
   "say": "Ces téléchargements sont-ils notés ailleurs ? | Par défaut, non. Les lectures relèvent d'un second registre, Data Access, éteint par défaut.",
   "guess": true,
   "pauseAt": 99.06153846153846
  },
  {
   "id": "c15",
   "start": 106.94615384615385,
   "end": 115.63846153846154,
   "say": "Pourquoi ? Des millions de lectures : trop de volume, trop de coût. Résultat : impossible de prouver le vol, ni son absence.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c16",
   "start": 115.63846153846154,
   "end": 122.02307692307693,
   "say": "Réflexe d'enquête : pivoter sur l'identité, et filtrer tout ce qu'a fait ce compte Gmail.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c17",
   "start": 122.02307692307693,
   "end": 129.56153846153848,
   "say": "Trois heures neuf : Create Service Account Key. Il se fabrique une clé de secours pour ci déployeur.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c18",
   "start": 129.56153846153848,
   "end": 137.8692307692308,
   "say": "On croit que retirer le rôle suffit. Faux : avec cette clé, il redevient ci déployeur, et se refait propriétaire.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c20",
   "start": 137.8692307692308,
   "end": 147.71538461538464,
   "say": "Recul : chaque projet a son propre registre. Un sink agrégé sur l'organisation les copie tous vers votre sim, au-delà de quatre cents jours.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c21",
   "start": 147.71538461538464,
   "end": 157.56153846153848,
   "say": "Verdict : clé volée utilisée à trois heures sept, clé de secours à trois heures neuf. On retire Owner, on supprime les deux clés.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c22",
   "start": 157.56153846153848,
   "end": 165.8692307692308,
   "say": "Vos trois actions : alerter sur ces deux méthodes, un sink vers le sim, Data Access sur les données sensibles.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c23",
   "start": 165.8692307692308,
   "end": 174.17692307692312,
   "say": "Vous savez maintenant dire qui, quand, d'où, et la suite. Nuance : une IP ou un e-mail peuvent être masqués.",
   "guess": false,
   "pauseAt": null
  }
 ]
}