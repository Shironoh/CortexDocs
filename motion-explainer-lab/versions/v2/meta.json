 "cues": [
  {
   "id": "c1",
   "start": 0.6,
   "end": 7.753846153846153,
   "say": "Trois heures douze. Alerte : un compte Gmail inconnu vient de devenir propriétaire du projet prod paiements.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c2",
   "start": 7.753846153846153,
   "end": 16.446153846153845,
   "say": "Vous ne connaissez pas Google Cloud, mais c'est à vous d'enquêter. Seule piste : ses journaux. Qui ? Quand ? D'où ? Et ensuite ?",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c3",
   "start": 16.446153846153845,
   "end": 23.98461538461538,
   "say": "Imaginez un immeuble. L'organisation, c'est le bâtiment ; chaque projet, un étage, avec ses machines et ses données.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c4",
   "start": 23.98461538461538,
   "end": 33.83076923076923,
   "say": "Personne n'entre par la fenêtre : console, ligne de commande ou script, tout passe par le guichet, l'API. Chaque geste y laisse une trace.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c5",
   "start": 33.83076923076923,
   "end": 42.52307692307692,
   "say": "Sans rien configurer, a-t-on cette trace ? Oui : toute action qui modifie un réglage est écrite dans le registre Admin Activity.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c6",
   "start": 42.52307692307692,
   "end": 52.36923076923077,
   "say": "On croit qu'il faut l'activer. Faux : il est toujours écrit, impossible à couper, gardé quatre cents jours. Google le juge indispensable à l'audit.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c7",
   "start": 52.36923076923077,
   "end": 62.176923076923075,
   "say": "Devinez : devenu propriétaire, l'attaquant peut-il effacer ce registre ? | Non : son coffre, Required, ne se supprime pas. L'historique est intact.",
   "guess": true,
   "pauseAt": 55.44615384615385
  },
  {
   "id": "c8",
   "start": 62.176923076923075,
   "end": 72.02307692307693,
   "say": "Ouvrons l'entrée de trois heures sept. Quoi ? Set I A M Policy, un changement de droits : le rôle Owner, donné au compte Gmail.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c9",
   "start": 72.02307692307693,
   "end": 83.75384615384615,
   "say": "Et qui a signé ? | Pas un humain : ci déployeur, un compte de service, l'identité du robot de déploiement. Sa clé a sans doute fuité.",
   "guess": true,
   "pauseAt": 73.56153846153846
  },
  {
   "id": "c10",
   "start": 83.75384615384615,
   "end": 92.83076923076923,
   "say": "D'où ? Une IP inconnue, et un outil déclaré par l'appelant : un indice, pas une preuve. Ces quatre champs font une règle.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c11",
   "start": 92.83076923076923,
   "end": 99.98461538461538,
   "say": "A-t-il lu les fichiers clients ? Admin Activity note les modifications. Or une lecture ne modifie rien.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c12",
   "start": 99.98461538461538,
   "end": 109.4076923076923,
   "say": "Ces lectures sont-elles notées ailleurs ? | Par défaut, non : elles relèvent d'un autre registre, Data Access, éteint par défaut.",
   "guess": true,
   "pauseAt": 101.9076923076923
  },
  {
   "id": "c13",
   "start": 109.4076923076923,
   "end": 118.1,
   "say": "Pourquoi ? Des millions de lectures : trop de volume, donc de coût. Résultat : impossible de prouver le vol, ou son absence.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c14",
   "start": 118.1,
   "end": 126.79230769230769,
   "say": "Et ensuite ? Réflexe d'enquête : pivoter sur l'identité, et filtrer tout ce qu'a fait ce compte Gmail depuis trois heures sept.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c15",
   "start": 126.79230769230769,
   "end": 135.1,
   "say": "Trois heures neuf : Create Service Account Key. Il fabrique une nouvelle clé pour ci déployeur : sa clé de secours.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c16",
   "start": 135.1,
   "end": 144.17692307692306,
   "say": "On croit que retirer le rôle suffit. Faux : avec cette clé, il redevient ci déployeur, et peut se redonner le rôle.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c17",
   "start": 144.17692307692306,
   "end": 154.79230769230767,
   "say": "Verdict : clé volée utilisée à trois heures sept, clé de secours à trois heures neuf. On retire Owner, on supprime toutes les clés du robot.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c18",
   "start": 154.79230769230767,
   "end": 164.6384615384615,
   "say": "Vos trois réflexes : une alerte sur l'ajout d'Owner et la création de clé ; Data Access sur vos données sensibles ; le pivot sur l'identité.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c19",
   "start": 164.6384615384615,
   "end": 172.17692307692306,
   "say": "Vous savez maintenant dire qui, quand, d'où, et la suite. Nuance : l'IP ou l'e-mail sont parfois masqués.",
   "guess": false,
   "pauseAt": null
  }
 ]
