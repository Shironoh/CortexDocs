 "cues": [
  {
   "id": "c1",
   "start": 0.6,
   "end": 10.83076923076923,
   "say": "Épisode deux. Trois heures sept : l'attaquant est devenu propriétaire. Mais un attaquant prudent ne garde pas une seule porte. Il en ouvre plusieurs. Lesquelles ?",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c2",
   "start": 10.83076923076923,
   "end": 20.29230769230769,
   "say": "Pour chacune, une fiche : la tactique, le nom exact de la méthode, et la condition qui transforme un événement banal en alerte.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c3",
   "start": 20.29230769230769,
   "end": 29.369230769230768,
   "say": "Première porte, la plus directe : il se donne un rôle. Owner ou Editor, accordé à un compte extérieur à votre entreprise.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c4",
   "start": 29.369230769230768,
   "end": 39.98461538461538,
   "say": "Méthode : Set I A M Policy. Condition : dans binding deltas, une action ADD, un rôle Owner ou Editor, et un membre hors de votre domaine.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c5",
   "start": 39.98461538461538,
   "end": 47.52307692307692,
   "say": "Deuxième porte : il crée son propre robot. Un nouveau compte de service, plus discret qu'un compte Gmail.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c6",
   "start": 47.52307692307692,
   "end": 56.599999999999994,
   "say": "Méthode : google I A M admin v1, Create Service Account. Condition : un créateur qui n'est pas l'un de vos pipelines habituels.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c7",
   "start": 56.599999999999994,
   "end": 64.13846153846153,
   "say": "Troisième porte : il fabrique une clé pour ce robot. Par défaut, une clé créée ainsi n'expire jamais.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c8",
   "start": 64.13846153846153,
   "end": 74.36923076923075,
   "say": "Méthode : Create Service Account Key. Condition : une clé créée hors rotation prévue, ou depuis une adresse inconnue. Réflexe : lister toutes les clés du robot.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c9",
   "start": 74.36923076923075,
   "end": 83.44615384615383,
   "say": "Quatrième porte : une clé S S H, posée dans les métadonnées du projet. Elle ouvre les machines virtuelles qui en héritent.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c10",
   "start": 83.44615384615383,
   "end": 92.9076923076923,
   "say": "Méthode : v1 compute projects, set Common Instance Metadata. Condition : project metadata delta contient ssh keys. Pour une seule machine : instances set Metadata.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c11",
   "start": 92.9076923076923,
   "end": 99.29230769230769,
   "say": "Cinquième porte, la plus discrète : emprunter l'identité d'un robot existant, avec un jeton temporaire.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c12",
   "start": 99.29230769230769,
   "end": 109.1,
   "say": "Méthode : Generate Access Token. Devinez : dans quel journal ? | Data access. Éteint par défaut : sans réglage, cette usurpation est invisible.",
   "guess": true,
   "pauseAt": 102.36923076923077
  },
  {
   "id": "c13",
   "start": 109.1,
   "end": 120.1,
   "say": "Ce qui reste dans activity : le Set I A M Policy qui a donné le rôle Service Account Token Creator. C'est ce rôle-là qu'il faut surveiller.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c14",
   "start": 120.1,
   "end": 129.94615384615383,
   "say": "On croit qu'il suffit de retirer Owner. Faux : chaque porte se ferme séparément. Rôles, robots, clés, clés S S H, et droits d'emprunt.",
   "guess": false,
   "pauseAt": null
  },
  {
   "id": "c15",
   "start": 129.94615384615383,
   "end": 142.48461538461538,
   "say": "Vos règles de persistance : Set I A M Policy, Create Service Account, Create Service Account Key, set Common Instance Metadata, et le rôle Token Creator. Épisode trois : effacer ses traces.",
   "guess": false,
   "pauseAt": null
  }
 ]
